{
	"schemaVersion": 1,
	"id": "aqd_mod",
	"version": "${version}",
	"name": "AQPie-Mod",
	"description": "This mod adds a AQPie to Minecraft",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/aqd-mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.aq.jaqmod.AQDMod"
		],
		"client": [
			"com.aq.jaqmod.client.AQDModClient"
		],
		"fabric-datagen": [
			"com.aq.jaqmod.client.AQDModDataGenerator"
		]
	},
	"mixins": [
		"aqd-mod.mixins.json",
		{
			"config": "aqd-mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}